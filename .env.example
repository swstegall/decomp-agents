# --- authentication --------------------------------------------------
# Two paths, pick ONE:
#
# A) Subscription (Claude Pro / Max):  run `claude` once in a terminal
#    to OAuth-login; credentials land in macOS Keychain. Leave
#    ANTHROPIC_API_KEY UNSET (or comment it out below). Optionally pin
#    intent with DECOMP_AUTH_MODE=subscription so a stray key in your
#    shell can't shadow OAuth.
#
# B) API key (pay-as-you-go):  paste a sk-ant-... key from
#    https://console.anthropic.com/settings/keys
#
# Leave both unset → auto-detect (subscription if no key is present).
# ANTHROPIC_API_KEY=sk-ant-...
# DECOMP_AUTH_MODE=subscription

# --- topology --------------------------------------------------------
# How many parallel workers to spawn. Recommended range 1-8.
# Each worker is its own Python subprocess pinned to its own git
# worktree. 5 is a balanced default; 7 saturates a single-machine
# Wine+MSVC build pipeline.
DECOMP_AGENT_WORKERS=5

# Absolute path to the meteor-decomp checkout the workers should
# operate on. Defaults to ../meteor-decomp relative to this project.
DECOMP_REPO=../meteor-decomp

# Which binary's YAML pool to chew through. One of:
#   ffxivgame | ffxivboot | ffxivlogin | ffxivconfig | ffxivupdater
# Workers pick functions from this YAML only — keeps build artefact
# contention bounded per-session.
DECOMP_BINARY=ffxivlogin

# Where worktrees live. Default is meteor-decomp/.worktrees/agent-N.
# Worktrees share the parent .git/ so they're cheap.
# DECOMP_WORKTREE_ROOT=../meteor-decomp/.worktrees

# --- budgets / bounds ------------------------------------------------
# Max function attempts per worker before it bails for the session.
DECOMP_MAX_ATTEMPTS_PER_WORKER=8

# Max iteration turns per function (claim → diff → iterate → ...).
# Hitting this releases the claim with status: blocked and rolls the
# worker onto the next function.
DECOMP_MAX_ITERATIONS_PER_FUNCTION=12

# Skip any function whose size > this (bytes). The yaml pool has
# functions from 0x6 to 0x2000+; the small ones match fastest.
DECOMP_MAX_FUNCTION_SIZE=0x200

# --- model tiering ---------------------------------------------------
# Workers pick one of three models per function based on difficulty:
#
#   triage      — small body (≤ 0x80 B), hand-named sibling .cpp to copy
#                 from, and Ghidra pseudo-C available. Cheapest model
#                 (haiku) is fine.
#   default     — everything in the middle. Sonnet is a balanced pick.
#   escalation  — large (> 0x180 B), no siblings & no pseudo-C, or a
#                 prior worker bailed (post-mortem on disk). Burn opus.
#
# Each accepts an alias (opus/sonnet/haiku) or a full model id
# (e.g. claude-opus-4-8). To disable tiering entirely, set all three
# to the same value.
DECOMP_TRIAGE_MODEL=haiku
DECOMP_WORKER_MODEL=sonnet
DECOMP_ESCALATION_MODEL=opus

# --- push policy -----------------------------------------------------
# What to push to origin after a successful match:
#   none              — never push (you push manually). Safest.
#   branches          — push each per-function branch after a match;
#                       master only advances locally. Lets you review
#                       each match as a remote branch / open PRs / run
#                       CI without auto-shipping to master.
#   branches+master   — push per-function branches AND push master after
#                       each successful merge. Fully autonomous shipping.
#                       Higher blast radius if a regression slips through.
DECOMP_AUTOPUSH=branches+master

# --- observability ---------------------------------------------------
# Where unified output goes. Default ./output relative to this repo.
# DECOMP_OUTPUT_DIR=./output

# Stream worker tool-use events to stdout in real time.
DECOMP_LIVE_TAIL=1

# --- mode: local (default) | distributed -----------------------------
# local        — the original topology: N git worktrees of a single
#                meteor-decomp checkout, a shared local SQLite claim
#                queue, and a local merge loop. Nothing below this line
#                is read.
# distributed  — fork-based, GitHub-native flow (issue #11): the agent
#                works from a FORK of meteor-decomp, claims VAs through
#                the upstream `claims` branch (driven by posting
#                `/claim FUN_<va> <binary>` on a coordination issue),
#                runs the SAME per-function match loop + GREEN gate, then
#                opens a PR upstream once a toolchain-free PR-gate passes.
#                The agent uses its OWN `gh auth` identity — run
#                `gh auth login` first; claims are attributed to that
#                login (no shared bot token).
DECOMP_MODE=local

# Canonical upstream repo the agent contributes to (owner/repo).
DECOMP_UPSTREAM=owner/meteor-decomp

# The contributor's FORK of the upstream. Leave UNSET to have the agent
# create/derive one under its own gh identity via `gh repo fork`.
# Otherwise set "owner/repo" or a full clone URL.
# DECOMP_FORK=your-login/meteor-decomp

# The upstream coordination ISSUE number whose comments fire claim.yml.
# REQUIRED when DECOMP_MODE=distributed. The agent posts
# `/claim FUN_<va> <binary>` there and polls the `claims` branch for the
# win.
# DECOMP_CLAIM_ISSUE=123

# Branch on upstream that PRs target (and that the fork tracks for the
# solved set). The D1 claim ledger model uses `develop`.
DECOMP_UPSTREAM_BRANCH=develop

# Where the fork working clone is checked out. Default ./output/fork.
# DECOMP_FORK_ROOT=./output/fork

# --- distributed: bring your own SE binary (copyright) ---------------
# `make diff` (the GREEN grader the PR-gate runs) needs TWO files that are
# gitignored in EVERY meteor-decomp clone — and therefore absent from the
# fresh fork clone distributed mode works in:
#
#   orig/<bin>.exe              — the Square Enix game binary
#   config/<bin>.symbols.json   — the Ghidra dump derived from that binary
#
# COPYRIGHT: these are SE-copyrighted (or derived) material. They are NEVER
# distributed, copied into git, or committed — we cannot ship them. You MUST
# provide your OWN local copy. Distributed mode only SYMLINKS them into the
# clone; the clone's .gitignore already ignores `orig/*` and
# `config/*.symbols.json`, so the symlinks can never be staged or land in
# your PR diff.
#
# Set this to a LOCAL meteor-decomp checkout that already holds your
# orig/<bin>.exe and config/<bin>.symbols.json (run `make split BINARY=<bin>.exe`
# there once if symbols.json is missing). When UNSET, it defaults to
# DECOMP_REPO if that checkout already has an orig/ dir (the common
# single-operator case); otherwise grading is disabled with a warning until
# you set it. Local mode ignores this entirely.
# DECOMP_ARTIFACTS_DIR=../meteor-decomp

# Bounded poll for a claim win against the upstream `claims` branch after
# posting `/claim`: total seconds to wait, and per-poll sleep seconds.
DECOMP_CLAIM_POLL_TIMEOUT_S=180
DECOMP_CLAIM_POLL_INTERVAL_S=6
